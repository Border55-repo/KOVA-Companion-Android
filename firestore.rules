rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /webPushSubscriptions/{subscriptionId} {
      allow read: if false;

      allow create, update: if
        request.resource.data.keys().hasOnly([
          'token',
          'organizations',
          'enabled',
          'updatedAt',
          'platform'
        ]) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 20 &&
        request.resource.data.token.size() < 4096 &&
        request.resource.data.organizations is list &&
        request.resource.data.organizations.size() <= 20 &&
        request.resource.data.enabled is bool &&
        request.resource.data.platform == 'pwa' &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
