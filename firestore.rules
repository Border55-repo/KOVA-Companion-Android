rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminIdentity() {
      return signedIn() &&
        request.auth.token.email == "superuser@kova-companion.local";
    }

    function adminReady() {
      return adminIdentity() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.mustChangePassword == false;
    }

    match /adminUsers/{uid} {
      allow read: if adminIdentity() && request.auth.uid == uid;

      allow create: if adminIdentity() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          'username', 'email', 'role', 'mustChangePassword',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.username == "superuser" &&
        request.resource.data.email == "superuser@kova-companion.local" &&
        request.resource.data.role == "superuser" &&
        request.resource.data.mustChangePassword == true &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if adminIdentity() &&
        request.auth.uid == uid &&
        resource.data.mustChangePassword == true &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.mustChangePassword == false &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.passwordChangedAt == request.time;

      allow delete: if false;
    }

    match /webPushSubscriptions/{subscriptionId} {
      allow read: if adminReady();
      allow delete: if false;

      allow create, update: if
        request.resource.data.keys().hasOnly([
          'endpoint',
          'p256dh',
          'auth',
          'organizations',
          'enabled',
          'updatedAt',
          'platform',
          'reminderToken',
          'notificationKinds',
          'disabledEventTypes',
          'quietHoursEnabled',
          'quietStartHour',
          'quietEndHour'
        ]) &&
        request.resource.data.endpoint is string &&
        request.resource.data.endpoint.size() > 20 &&
        request.resource.data.endpoint.size() < 4096 &&
        request.resource.data.p256dh is string &&
        request.resource.data.p256dh.size() > 20 &&
        request.resource.data.p256dh.size() < 1024 &&
        request.resource.data.auth is string &&
        request.resource.data.auth.size() > 5 &&
        request.resource.data.auth.size() < 512 &&
        request.resource.data.organizations is list &&
        request.resource.data.organizations.size() <= 100 &&
        request.resource.data.enabled is bool &&
        (
          !request.resource.data.keys().hasAny(['notificationKinds']) ||
          (
            request.resource.data.notificationKinds is list &&
            request.resource.data.notificationKinds.size() <= 4
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['disabledEventTypes']) ||
          (
            request.resource.data.disabledEventTypes is list &&
            request.resource.data.disabledEventTypes.size() <= 100
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['quietHoursEnabled']) ||
          request.resource.data.quietHoursEnabled is bool
        ) &&
        (
          !request.resource.data.keys().hasAny(['quietStartHour']) ||
          (
            request.resource.data.quietStartHour is int &&
            request.resource.data.quietStartHour >= 0 &&
            request.resource.data.quietStartHour <= 23
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['quietEndHour']) ||
          (
            request.resource.data.quietEndHour is int &&
            request.resource.data.quietEndHour >= 0 &&
            request.resource.data.quietEndHour <= 23
          )
        ) &&
        request.resource.data.platform == 'pwa' &&
        (
          !request.resource.data.keys().hasAny(['reminderToken']) ||
          (
            request.resource.data.reminderToken is string &&
            request.resource.data.reminderToken.size() >= 32 &&
            request.resource.data.reminderToken.size() <= 128
          )
        ) &&
        request.resource.data.updatedAt == request.time;
    }

    match /webPushReminders/{reminderId} {
      allow read: if adminReady();
      allow delete: if false;

      allow create, update: if
        request.resource.data.keys().hasOnly([
          'subscriptionId',
          'reminderToken',
          'organization',
          'eventId',
          'semanticKey',
          'dateIso',
          'time',
          'description',
          'leadMinutes',
          'enabled',
          'updatedAt'
        ]) &&
        request.resource.data.subscriptionId is string &&
        request.resource.data.subscriptionId.size() == 64 &&
        request.resource.data.reminderToken is string &&
        request.resource.data.reminderToken.size() >= 32 &&
        request.resource.data.reminderToken.size() <= 128 &&
        exists(
          /databases/$(database)/documents/webPushSubscriptions/$(request.resource.data.subscriptionId)
        ) &&
        get(
          /databases/$(database)/documents/webPushSubscriptions/$(request.resource.data.subscriptionId)
        ).data.reminderToken == request.resource.data.reminderToken &&
        request.resource.data.organization is string &&
        request.resource.data.organization.size() > 0 &&
        request.resource.data.organization.size() <= 128 &&
        request.resource.data.eventId is string &&
        request.resource.data.eventId.size() > 0 &&
        request.resource.data.eventId.size() <= 128 &&
        request.resource.data.semanticKey is string &&
        request.resource.data.semanticKey.size() > 2 &&
        request.resource.data.semanticKey.size() <= 1000 &&
        request.resource.data.dateIso is string &&
        request.resource.data.dateIso.size() <= 16 &&
        request.resource.data.time is string &&
        request.resource.data.time.size() <= 64 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 1000 &&
        request.resource.data.leadMinutes is int &&
        request.resource.data.leadMinutes >= 5 &&
        request.resource.data.leadMinutes <= 10080 &&
        request.resource.data.enabled is bool &&
        request.resource.data.updatedAt == request.time;
    }

    match /webPushReminderState/{reminderId} {
      allow read, write: if false;
    }

    match /publicConfig/pwa {
      allow read: if true;
      allow write: if adminReady() &&
        request.resource.data.keys().hasOnly(['cacheEpoch', 'updatedAt']) &&
        request.resource.data.cacheEpoch is int &&
        request.resource.data.cacheEpoch > 0 &&
        request.resource.data.updatedAt == request.time;
    }

    match /adminRuntime/{documentId} {
      allow read: if adminReady();
      allow write: if false;
    }

    match /adminCommands/bridgeSync {
      allow read: if adminReady();
      allow create, update: if adminReady() &&
        request.resource.data.keys().hasOnly([
          'action', 'status', 'requestId', 'requestedBy', 'requestedAt'
        ]) &&
        request.resource.data.action == 'bridgeSync' &&
        request.resource.data.status == 'requested' &&
        request.resource.data.requestId is string &&
        request.resource.data.requestId.size() >= 8 &&
        request.resource.data.requestId.size() <= 128 &&
        request.resource.data.requestedBy == 'superuser' &&
        request.resource.data.requestedAt == request.time;
      allow delete: if false;
    }

    match /changelog/{entryId} {
      allow read: if true;
      allow create: if adminReady() &&
        request.resource.data.keys().hasOnly(['id','title','body','publishedAt','publishedBy','sendPush']) &&
        request.resource.data.id == entryId &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 80 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 2000 &&
        request.resource.data.publishedBy == 'superuser' &&
        request.resource.data.sendPush is bool &&
        request.resource.data.publishedAt == request.time;
      allow update, delete: if false;
    }

    match /publicConfig/changelog {
      allow read: if true;
      allow create, update: if adminReady() &&
        request.resource.data.keys().hasOnly(['latestId','title','body','updatedAt']) &&
        request.resource.data.latestId is string &&
        request.resource.data.title is string &&
        request.resource.data.body is string &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /adminCommands/announcement {
      allow read: if adminReady();
      allow create, update: if adminReady() &&
        request.resource.data.keys().hasOnly([
          'action','status','requestId','title','body','topic',
          'requestedBy','requestedAt','source','audience','organization','subscriptionId'
        ]) &&
        request.resource.data.action == 'announcement' &&
        request.resource.data.status == 'requested' &&
        request.resource.data.requestId is string &&
        request.resource.data.title is string &&
        request.resource.data.body is string &&
        request.resource.data.topic == 'kova_all_users' &&
        (!('audience' in request.resource.data) || (
          request.resource.data.audience in ['all','organization','test'] &&
          request.resource.data.organization is string &&
          request.resource.data.subscriptionId is string &&
          (request.resource.data.audience != 'organization' || request.resource.data.organization.size() > 0) &&
          (request.resource.data.audience != 'test' || request.resource.data.subscriptionId.matches('[a-f0-9]{64}'))
        )) &&
        request.resource.data.requestedBy == 'superuser' &&
        request.resource.data.source == 'changelog' &&
        request.resource.data.requestedAt == request.time;
      allow delete: if false;
    }

    match /webPushConfig/{documentId} {
      allow read, write: if false;
    }
  }
}
